---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudy from '../components/CaseStudy.astro';
const implementationPlaybooks = [
  {
    key: 'text',
    label: '文章',
    icon: 'article',
    title: '仕様変更を、すぐ動ける説明文に変える',
    useCase: '多言語切り替えの不具合修正に入る前に、関係ファイル、影響範囲、確認観点を短い作業メモへ落とす。',
    deliverable: 'PR 下書き、実装方針メモ、レビュー依頼文',
    contextLabel: '要件 / コード / 不具合内容',
    contextPlaceholder: '例: React の多言語切り替え不具合。Header.tsx、i18n.ts、LanguageMenu.tsx が関係し、一部文言だけ更新されない。',
    prompt: `以下の開発コンテキストをもとに、実装前の整理文を作成してください。\n開発コンテキスト:\n__CONTEXT__\n以下の形式で日本語で出力してください:\n1. 問題の要約\n2. 影響範囲の候補\n3. 先に確認すべきファイルと理由\n4. 修正方針の短いメモ\n5. レビュー依頼に使える説明文`
  },
  {
    key: 'html',
    label: 'HTML',
    icon: 'html',
    title: '検証用の画面を、ブラウザで即確認できる形にする',
    useCase: '社内向けの CSV インポート確認画面を、デザイナーを待たずに HTML モックとして先に出す。',
    deliverable: '検証用 HTML、メールテンプレート、簡易 UI モック',
    contextLabel: '画面要件 / 見た目の条件',
    contextPlaceholder: '例: CSV インポート確認ページ。件数カード、エラー一覧、再アップロード、取込開始ボタンが必要。',
    prompt: `以下の画面要件をもとに、1 ファイルで動く HTML を作成してください。\n画面要件:\n__CONTEXT__\n条件:\n- そのままブラウザで確認できる構成にする\n- 最低限の CSS を含める\n- 管理画面らしい落ち着いた見た目にする\n- 必要なボタン、一覧、状態表示を含める`
  },
  {
    key: 'script',
    label: 'スクリプト',
    icon: 'terminal',
    title: '繰り返し作業を、すぐ回せる自動化に置き換える',
    useCase: '毎朝のログ整形や Excel 貼り付け作業を、VBA や Shell の下書きで一気に減らす。',
    deliverable: 'VBA、Shell、PowerShell、SQL の草案',
    contextLabel: '作業手順 / 入出力条件',
    contextPlaceholder: '例: export フォルダの最新 CSV を整形し、failed 行だけ別ファイルに出したい。zsh で動かす。',
    prompt: `以下の作業条件をもとに、自動化スクリプトの草案を作成してください。\n作業条件:\n__CONTEXT__\n以下の方針で出力してください:\n- すぐ試せる最小構成にする\n- コメントを付ける\n- 入力と出力を明示する\n- Shell / PowerShell / VBA / SQL のうち適切な形式を選ぶ\n- 最後に実行時の注意点も書く`
  },
  {
    key: 'framework',
    label: 'フレームワークコード',
    icon: 'deployed_code',
    title: '既存アプリに貼れる雛形を、先に整えてから進める',
    useCase: '決済 webhook 受信処理の追加時に、C# や Java の controller、service、DTO の叩き台を先に作る。',
    deliverable: 'C#、Java、React、Spring、ASP.NET の雛形',
    contextLabel: '機能要件 / 対象フレームワーク',
    contextPlaceholder: '例: Spring Boot API に payment webhook を追加したい。Controller、DTO、Service の最小雛形が欲しい。',
    prompt: `以下の機能要件をもとに、既存アプリへ貼り込みやすい実装雛形を作成してください。\n機能要件:\n__CONTEXT__\n出力条件:\n- 適切なフレームワークと言語を判断する\n- Controller / Service / DTO など必要な単位に分ける\n- 最小構成に絞る\n- ログや異常系の扱いも含める\n- すぐ実装に着手できる粒度にする`
  }
];

const [rawDefaultBefore, rawDefaultAfter = ''] = implementationPlaybooks[0].prompt.split('__CONTEXT__');
const defaultBefore = rawDefaultBefore.replace(/\n+$/, '');
const defaultAfter = rawDefaultAfter.replace(/^\n+/, '');
---

<BaseLayout title="AI開発実践ガイド | 開発" current="interactive">
  <section class="hero">
    <div class="hero-tag">
      <span class="material-symbols-outlined" aria-hidden="true">code_blocks</span>
      <div class="section-tag">開発</div>
    </div>
    <h1>実装前の整理を AI に任せる</h1>
    <p>
      開発で時間を奪うのは、コードを書くことよりも、既存コードの理解、変更範囲の把握、エラーの読み解きです。
      ブラウザ型 AI は、実装に入る前の整理役であると同時に、HTML、VBA、Shell、C#、Java などの
      雛形を出す作業相手としても使いやすくなります。
    </p>
  </section>

  <section class="grid">
    <article class="card span-6">
      <div class="card-head">
        <span class="material-symbols-outlined" aria-hidden="true">bug_report</span>
        <span class="kicker">課題</span>
      </div>
      <ul class="challenge-list">
        <li>見慣れないコードでは、文脈理解に時間がかかる。</li>
        <li>小さな変更でも、影響範囲が広がりやすい。</li>
        <li>エラー内容を読むだけで調査が止まりやすい。</li>
      </ul>
    </article>

    <article class="card span-6">
      <div class="card-head">
        <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
        <span class="kicker">AI の使いどころ</span>
      </div>
      <ul class="detail-list">
        <li>既存コードと主要な呼び出し経路を説明し、変更方針を整理する。</li>
        <li>要件を実装手順に分解し、HTML や補助コードの雛形に落とす。</li>
        <li>エラーを調査順序つきで言い換え、必要なら C#、Java、VBA、Shell などの草案を出す。</li>
      </ul>
    </article>

    <article class="card soft span-12">
      <div class="card-head">
        <span class="material-symbols-outlined" aria-hidden="true">snippet_folder</span>
        <span class="kicker">入力素材</span>
      </div>
      <ul class="step-list">
        <li>コード片、PR 説明、要件メモ、ターミナルログ、画面キャプチャ、既存画面の HTML。</li>
        <li>まずは「この変更でどこを触るべきか」を整理させ、その後で HTML、補助スクリプト、アプリコードへ分岐させる使い方が安定します。</li>
      </ul>
    </article>

  </section>

  <article
    class="card span-12 integrated-lab"
    data-integrated-lab
    data-default-template={implementationPlaybooks[0].prompt}
    data-default-label={implementationPlaybooks[0].contextLabel}
    data-default-placeholder={implementationPlaybooks[0].contextPlaceholder}
  >
    <div class="card-head">
      <span class="material-symbols-outlined" aria-hidden="true">chat</span>
      <span class="kicker">Prompt Lab</span>
    </div>
    <h3 class="panel-title">開発支援用 Prompt</h3>
    <p class="panel-copy">
      出力タイプごとに、ユースケース、成果物、prompt が連動して切り替わります。
      開発では、何を書かせるかより先に、どの形で出させるかを決めると使いやすくなります。
    </p>

    <div class="playbook-deck" aria-label="開発出力タイプの切り替え">
      {implementationPlaybooks.map((playbook, index) => (
        <button
          class={`playbook-card-button ${index === 0 ? 'is-active' : ''}`}
          type="button"
          data-playbook-card={playbook.key}
          data-template={playbook.prompt}
          data-context-label={playbook.contextLabel}
          data-context-placeholder={playbook.contextPlaceholder}
        >
          <span class="material-symbols-outlined" aria-hidden="true">{playbook.icon}</span>
          <strong>{playbook.label}</strong>
          <small>{playbook.title}</small>
          <em>{playbook.deliverable}</em>
        </button>
      ))}
    </div>

    <div class="playbook-live">
      {implementationPlaybooks.map((playbook, index) => (
        <section
          class={`playbook-live-panel ${index === 0 ? 'is-active' : ''}`}
          data-live-panel={playbook.key}
        >
          <div class="playbook-live-meta">
            <div class="card-head">
              <span class="material-symbols-outlined" aria-hidden="true">{playbook.icon}</span>
              <span class="kicker">{playbook.label}</span>
            </div>
            <h4 class="panel-title">{playbook.title}</h4>
            <div class="detail-list">
              <div>
                <strong class="playbook-label">ユースケース</strong>
                <p class="muted">{playbook.useCase}</p>
              </div>
              <div>
                <strong class="playbook-label">出力されるもの</strong>
                <p class="muted">{playbook.deliverable}</p>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <div class="prompt-lab" data-prompt-lab="implementation-lab" data-template={implementationPlaybooks[0].prompt}>
      <label>
        <div class="card-head card-head-compact">
          <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
          <div class="section-tag" data-role="context-label">{implementationPlaybooks[0].contextLabel}</div>
        </div>
        <textarea
          class="prompt-input"
          data-role="context"
          placeholder={implementationPlaybooks[0].contextPlaceholder}
        ></textarea>
      </label>

      <label>
        <div class="card-head card-head-compact">
          <span class="material-symbols-outlined" aria-hidden="true">text_snippet</span>
          <div class="section-tag">生成された Prompt</div>
        </div>
        <div class="prompt-preview-stack">
          <textarea class="prompt-preview prompt-preview-block" data-role="preview-before">{defaultBefore}</textarea>
          <textarea class="prompt-preview prompt-preview-block prompt-preview-context" data-role="preview-context" readonly></textarea>
          <textarea class="prompt-preview prompt-preview-block" data-role="preview-after">{defaultAfter}</textarea>
        </div>
      </label>

      <div class="prompt-actions">
        <a class="button-primary" data-role="launch" href="https://chatgpt.com/" target="_blank" rel="noreferrer">
          <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
          ChatGPT で試す
        </a>
        <button class="button-secondary" data-role="copy" type="button">
          <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
          Prompt をコピー
        </button>
      </div>

      <p class="caption">
        文章、HTML、スクリプト、フレームワークコードで出口を切り替えると、同じ開発課題でも AI の使い方が大きく変わります。
      </p>
    </div>
  </article>

  <CaseStudy
    title="Spring Boot に決済 webhook を追加する例"
    intro="開発段階では、実装前の整理と最小雛形づくりを早く回せるかが重要です。ここでは、既存 API に webhook 受信処理を追加するケースを例にしています。"
    fitTitle="向いている課題"
    fitBody="既存アプリに新しい endpoint や service を足したいが、どの単位に分けて着手するか迷う場面です。"
    outputTitle="得たい成果物"
    outputBody="Controller、Service、DTO の最小雛形と、異常系を含めた実装メモです。"
    problem="決済 webhook を受けたあとに注文状態を更新する処理を、既存の Spring Boot API に追加したい。"
    before="既存コードを読みながら手で構成を考えるため、最初の 1 手が遅くなりやすく、抜け漏れも出やすくなります。"
    after="要件と制約を prompt に入れて、受信 endpoint、DTO、service の最小構成を先に出し、そこから本実装へ進めます。"
    impact="着手速度、責務分割、レビュー前の共有、異常系の洗い出しが良くなります。"
    role="機能要件を、貼り込み可能な雛形と実装メモに変換し、最初の実装コストを下げることです。"
    promptBody={`以下の機能要件をもとに、既存の Spring Boot API へ payment webhook を追加する最小雛形を作成してください。
要件:
- POST /api/payments/webhook を追加する
- request body は eventId, orderId, status, paidAt を含む
- status=PAID のとき注文状態を更新する
- 署名検証の TODO を残す
- Controller / Service / DTO に分ける
- 異常系とログ出力も含める`}
    responseLabel="返答イメージ"
    responseLead="ChatGPT には、最初から完成品を期待するのではなく、貼り込みやすい骨組みを出させる使い方が向いています。"
  />

  <div class="footer">開発では、完成品を期待するより、叩き台を素早く出させる使い方が安定します。最後の実装判断は人が行います。</div>
</BaseLayout>

<script>
  const lab = document.querySelector('[data-integrated-lab]');

  if (lab instanceof HTMLElement) {
    const cards = lab.querySelectorAll('[data-playbook-card]');
    const panels = lab.querySelectorAll('[data-live-panel]');
    const promptLab = lab.querySelector('[data-prompt-lab]');
    const context = lab.querySelector('[data-role="context"]');
    const previewBefore = lab.querySelector('[data-role="preview-before"]');
    const previewContext = lab.querySelector('[data-role="preview-context"]');
    const previewAfter = lab.querySelector('[data-role="preview-after"]');
    const launch = lab.querySelector('[data-role="launch"]');
    const copy = lab.querySelector('[data-role="copy"]');
    const contextLabel = lab.querySelector('[data-role="context-label"]');

    if (
      promptLab instanceof HTMLElement &&
      context instanceof HTMLTextAreaElement &&
      previewBefore instanceof HTMLTextAreaElement &&
      previewContext instanceof HTMLTextAreaElement &&
      previewAfter instanceof HTMLTextAreaElement &&
      launch instanceof HTMLAnchorElement &&
      copy instanceof HTMLButtonElement &&
      contextLabel instanceof HTMLElement
    ) {
      const getCombinedPrompt = () => {
        return [previewBefore.value, previewContext.value, previewAfter.value]
          .filter((part) => part.length > 0)
          .join('');
      };

      const updateLaunch = () => {
        const url = new URL('https://chatgpt.com/');
        url.searchParams.set('q', getCombinedPrompt());
        launch.href = url.toString();
      };

      const updateContextPreview = () => {
        const value = context.value.trim() || 'ここに要件、コード片、画面要件、エラー内容、作業条件などを入力してください。';
        previewContext.value = value;
        updateLaunch();
      };

      const resetPromptTemplate = () => {
        const template = promptLab.getAttribute('data-template') ?? '';
        const [before, after = ''] = template.split('__CONTEXT__');
        previewBefore.value = before.replace(/\n+$/, '');
        previewAfter.value = after.replace(/^\n+/, '');
        updateContextPreview();
      };

      const activate = (key: string, card: Element) => {
        for (const item of cards) {
          item.classList.toggle('is-active', item === card);
        }

        for (const panel of panels) {
          panel.classList.toggle('is-active', panel.getAttribute('data-live-panel') === key);
        }

        promptLab.setAttribute('data-template', card.getAttribute('data-template') ?? '');
        contextLabel.textContent = card.getAttribute('data-context-label') ?? '';
        context.placeholder = card.getAttribute('data-context-placeholder') ?? '';
        resetPromptTemplate();
      };

      for (const card of cards) {
        card.addEventListener('click', () => {
          const key = card.getAttribute('data-playbook-card');
          if (key) activate(key, card);
        });
      }

      context.addEventListener('input', updateContextPreview);
      for (const field of [previewBefore, previewContext, previewAfter]) {
        field.addEventListener('input', updateLaunch);
      }
      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(getCombinedPrompt());
        copy.textContent = 'コピーしました';
        window.setTimeout(() => {
          copy.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">content_copy</span>Prompt をコピー';
        }, 1500);
      });

      resetPromptTemplate();
    }
  }
</script>
