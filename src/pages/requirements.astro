---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptLab from '../components/PromptLab.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { caseStudyPreviewConfig } from '../data/caseStudyPreviewConfig';
---

<BaseLayout title="AI開発実践ガイド | 要件定義" current="requirements">
  <section class="hero">
    <div class="hero-tag">
      <span class="material-symbols-outlined" aria-hidden="true">description</span>
      <div class="section-tag">要件定義</div>
    </div>
    <h1>曖昧な話を、実行できる要件に変える</h1>
    <p>
      要件定義で難しいのは、情報不足よりも、情報が散らばっていることです。
      ブラウザ型 AI は、会議メモやチャットの断片を整理し、仕様文、受け入れ条件、論点一覧のような
      次の工程で使える文章へまとめるのに向いています。
    </p>
  </section>

  <section class="grid">
    <div class="section-block span-12">
      <div class="section-block-head">
        <div class="card-head">
          <span class="material-symbols-outlined" aria-hidden="true">explore</span>
          <span class="kicker">1</span>
        </div>
        <div class="section-block-copywrap">
          <h2 class="section-block-title">要件工程の論点</h2>
          <p class="section-block-copy">要件を曖昧にしやすい論点と、AI に渡すと整理しやすい一次情報をまとめています。</p>
        </div>
      </div>
      <div class="grid section-block-grid">
        <article class="card span-6">
          <div class="card-head">
            <span class="material-symbols-outlined" aria-hidden="true">error</span>
            <span class="kicker">課題</span>
          </div>
          <ul class="challenge-list">
            <li>誰の発言を基準にするかが曖昧になりやすい。</li>
            <li>やりたいことは語られても、受け入れ条件が定義されない。</li>
            <li>非機能要件や制約条件が後から出てきやすい。</li>
          </ul>
        </article>

        <article class="card span-6">
          <div class="card-head">
            <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
            <span class="kicker">AI の使いどころ</span>
          </div>
          <ul class="detail-list">
            <li>会議メモを要件一覧や要件要約文に整理する。</li>
            <li>受け入れ条件、未解決事項、確認項目を文章として抽出する。</li>
            <li>MVP 範囲と後続課題を分け、Jira や Backlog に流しやすい粒度へ整える。</li>
          </ul>
        </article>

        <article class="card soft span-12">
          <div class="card-head">
            <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
            <span class="kicker">入力素材</span>
          </div>
          <ul class="step-list">
            <li>会議メモ、チャット履歴、顧客要望、競合サービスの説明、営業からの口頭メモ。</li>
            <li>まだ整理していない一次情報のほうが有効で、AI には「仕様書にする前の素材」を渡すのが向いています。</li>
          </ul>
        </article>
      </div>
    </div>

    <div class="section-block span-12">
      <div class="section-block-head">
        <div class="card-head">
          <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          <span class="kicker">2</span>
        </div>
        <div class="section-block-copywrap">
          <h2 class="section-block-title">Prompt 設計</h2>
          <p class="section-block-copy">会議メモや要望の断片を、そのまま要件文と受け入れ条件へ変換しやすい形に整えます。</p>
        </div>
      </div>
      <PromptLab
        id="requirements-lab"
        title="要件定義用 Prompt"
        intro="会議メモやチャット原文を貼ると、要件整理文や受け入れ条件の作成に使いやすい prompt を生成します。"
        contextLabel="会議メモ / チャット履歴 / 要望"
        contextPlaceholder="例: 顧客一覧を管理画面から一括インポートしたい。Excel 対応が必要。営業は取り消し機能を求めている。来週のデモまでに見せられる形にしたい。"
        promptTemplate={`あなたは経験豊富なプロダクトマネージャー兼ソフトウェアアナリストです。以下の一次情報を、実行可能な要件へ整理してください。
一次情報:
__CONTEXT__
以下の形式で出力してください:
1. この要件が解決したい課題を要約する。
2. 利用者と目的を整理する。
3. 機能要件、非機能要件、制約条件に分ける。
4. MVP に含める内容と後続に回す内容を分ける。
5. テスト可能な受け入れ条件を書く。
6. 不明点と追加確認が必要な点を列挙する。
7. 最後に、会議用要約とチケット化用要約をそれぞれ短く作る。`}
        promptNote="要件段階では、仕様文だけでなく、設計レビュー用の要約文とチケット化用の文章まで作らせると、そのまま次工程へつなげやすくなります。"
      />
    </div>

    <div class="section-block span-12">
      <div class="section-block-head">
        <div class="card-head">
          <span class="material-symbols-outlined" aria-hidden="true">toggle_on</span>
          <span class="kicker">3</span>
        </div>
        <div class="section-block-copywrap">
          <h2 class="section-block-title">ケース分析</h2>
          <p class="section-block-copy">要件整理の前後差分と、会議メモからどう合意用の文章へ変わるかを一続きで確認できます。</p>
        </div>
      </div>
      <CaseStudy
        title="顧客一覧の一括インポート要件をまとめる例"
        intro="要件定義では、散らばった発言を整理して、次工程で使える文章にすることが最初の価値になります。"
        fitTitle="向いている課題"
        fitBody="営業、顧客、開発の話が混ざっていて、何を先に決めるべきか見えにくい案件です。"
        outputTitle="得たい成果物"
        outputBody="要件要約、MVP 範囲、受け入れ条件、未確定事項の一覧です。"
        problem="顧客一覧を Excel から一括インポートしたいが、取消機能やエラーハンドリングまで含めるべきかが曖昧です。"
        before="会議メモとチャットを見返しながら手で仕様化するため、論点の抜けや優先順位のぶれが起きやすくなります。"
        after="一次情報をまとめて AI に渡し、利用者、制約、受け入れ条件、MVP 範囲を先に文章化してから会議に持ち込みます。"
        impact="論点の見落としが減り、合意形成とチケット化が早くなります。"
        role="断片的な会話を、合意に使える要件文と確認項目に変換することです。"
        promptBody={`以下の一次情報を、実行可能な要件へ整理してください。
一次情報:
- 顧客一覧を管理画面から一括インポートしたい
- Excel 対応が必要
- 営業は取り消し機能を求めている
- 来週のデモまでに見せられる形にしたい
- エラーがある行だけ確認できるようにしたい`}
        responseLabel="返答イメージ"
        responseLead="返答では、議論の順番が見えることが重要です。要件文だけでなく、未決定事項も一緒に出させます。"
        previewHref={caseStudyPreviewConfig.requirements.previewHref}
      />
    </div>
  </section>

  <div class="footer">要件定義では、まず話を揃えることが重要です。AI は整理を速くできますが、優先順位と合意は人が決めます。</div>
</BaseLayout>
