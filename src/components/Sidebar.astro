---
const { current = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;

const items = [
  { id: 'requirements', href: `${base}requirements/`, icon: 'description', label: '要件定義' },
  { id: 'design', href: `${base}design/`, icon: 'architecture', label: '設計' },
  { id: 'interactive', href: `${base}interactive/`, icon: 'code', label: '開発' },
  { id: 'testing', href: `${base}testing/`, icon: 'biotech', label: 'テスト' },
  { id: 'deployment', href: `${base}deployment/`, icon: 'rocket_launch', label: 'デプロイ' },
  { id: 'maintenance', href: `${base}maintenance/`, icon: 'build', label: '保守' }
];
---

<aside class="sidebar">
  <a class="brand" href={`${base}`}>AI開発実践ガイド</a>
  <div class="side-label">開発実践ナビ</div>
  <div class="mobile-nav">
    <label class="mobile-nav-label" for="page-nav">ページを選択</label>
    <div class="mobile-nav-shell">
      <select
        id="page-nav"
        class="mobile-nav-select"
        aria-label="ページを選択"
        onchange="if (this.value) window.location.href = this.value;"
      >
        <option value={`${base}`} selected={current === 'home'}>ホーム</option>
        {items.map((item) => (
          <option value={item.href} selected={item.id === current}>{item.label}</option>
        ))}
      </select>
      <span class="mobile-nav-icon material-symbols-outlined" aria-hidden="true">expand_more</span>
    </div>
  </div>
  <nav class="nav-list">
    {items.map((item) => (
      <a class={`nav-item ${item.id === current ? 'active' : ''}`} href={item.href}>
        <span class="material-symbols-outlined">{item.icon}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
</aside>
