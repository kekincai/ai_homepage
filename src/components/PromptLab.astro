---
const {
  id,
  title,
  intro,
  contextLabel = 'プロジェクトの背景を入力',
  contextPlaceholder = '',
  promptTemplate = '',
  promptNote = ''
} = Astro.props;
---

<article class="card span-12" data-prompt-lab={id} data-template={promptTemplate}>
  <div class="card-head">
    <span class="material-symbols-outlined" aria-hidden="true">chat</span>
    <span class="kicker">Prompt Lab</span>
  </div>
  <h3 class="panel-title">{title}</h3>
  <p class="panel-copy">{intro}</p>

  <div class="prompt-lab">
    <label>
      <div class="card-head card-head-compact">
        <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
        <div class="section-tag">{contextLabel}</div>
      </div>
      <textarea
        class="prompt-input"
        data-role="context"
        placeholder={contextPlaceholder}
      ></textarea>
    </label>

    <label>
      <div class="card-head card-head-compact">
        <span class="material-symbols-outlined" aria-hidden="true">text_snippet</span>
        <div class="section-tag">生成された Prompt</div>
      </div>
      <textarea class="prompt-preview" data-role="preview" readonly>{promptTemplate}</textarea>
    </label>

    <div class="prompt-actions">
      <a class="button-primary" data-role="launch" href="https://chatgpt.com/" target="_blank" rel="noreferrer">
        <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
        ChatGPT で試す
      </a>
      <button class="button-secondary" data-role="copy" type="button">
        <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
        Prompt をコピー
      </button>
    </div>

    {promptNote && <p class="caption">{promptNote}</p>}
  </div>
</article>

<script>
  const labs = document.querySelectorAll('[data-prompt-lab]');

  for (const lab of labs) {
    const template = lab.getAttribute('data-template') ?? '';
    const context = lab.querySelector('[data-role="context"]');
    const preview = lab.querySelector('[data-role="preview"]');
    const launch = lab.querySelector('[data-role="launch"]');
    const copy = lab.querySelector('[data-role="copy"]');

    if (!(context instanceof HTMLTextAreaElement) || !(preview instanceof HTMLTextAreaElement) || !(launch instanceof HTMLAnchorElement) || !(copy instanceof HTMLButtonElement)) {
      continue;
    }

    const updatePrompt = () => {
      const value = context.value.trim() || 'ここにプロジェクトの背景、コード片、エラー内容、画面説明などを入力してください。';
      const prompt = template.replace('__CONTEXT__', value);
      preview.value = prompt;

      const url = new URL('https://chatgpt.com/');
      url.searchParams.set('q', prompt);
      launch.href = url.toString();
    };

    context.addEventListener('input', updatePrompt);
    copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText(preview.value);
      copy.textContent = 'コピーしました';
      window.setTimeout(() => {
        copy.textContent = 'Prompt をコピー';
      }, 1500);
    });

    updatePrompt();
  }
</script>
